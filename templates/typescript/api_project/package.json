{
  "name": "express-server-project",
  "version": "0.1.0",
  "description": "Express server project using @themost framework",
  "main": "dist/server/standalone.js",
  "private": true,
  "scripts": {
    "start": "node dist/server/standalone",
    "build": "rimraf dist && tsc && cpy \"server/**/*.{html,css,twig,json}\" dist/server",
    "cli": "themost",
    "dev": "nodemon dist/server/standalone",
    "lint": "eslint --ext .ts server"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@themost/cli": "^2.1.8",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/lodash": "^4.17.26",
    "@types/minimist": "^1.2.5",
    "@types/serve-static": "^2.2.0",
    "@types/twig": "^1.12.17",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.14",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@themost/client": "^2",
    "@themost/common": "^2",
    "@themost/data": "^2",
    "@themost/express": "^5",
    "@themost/node": "^2",
    "@themost/query": "^2",
    "@themost/sqlite": "lts-22",
    "@themost/web": "^2",
    "@themost/xml": "^2",
    "express": "^5.3.0",
    "minimist": "^1.2.8",
    "twig": "^3.0.0"
  }
}
