{
    "ts-node": {
        "files": true
    },
    "compilerOptions": {
        "rootDir": ".",
        "ignoreDeprecations": "6.0",
        "outDir": "./dist",
        "preserveSymlinks": true,
        "sourceMap": true,
        "target": "es6",
        "module": "commonjs",
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "removeComments": false,
        "noImplicitAny": false,
        "resolveJsonModule": true,
        "declaration": true,
        "strict": true,
        "stripInternal": true,
        "typeRoots": [
            "node_modules/@types"
        ],
        "lib": [
            "es2017", 
            "dom"
        ]
    },
    "include": [
        "server/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "spec"
    ]
}
