{
  "name": "express-server-project",
  "version": "0.1.0",
  "description": "Express server project using @themost framework",
  "main": "dist/server/standalone.js",
  "private": true,
  "scripts": {
    "start": "node dist/server/standalone.js",
    "build": "rimraf dist/server && babel server --out-dir dist/server --copy-files --source-maps",
    "cli": "themost",
    "dev": "nodemon dist/server/standalone.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7",
    "@babel/core": "^7",
    "@babel/plugin-proposal-decorators": "^7",
    "@babel/preset-env": "^7",
    "@babel/register": "^7",
    "@babel/runtime": "^7",
    "@themost/cli": "^2",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/lodash": "^4.17.26",
    "@types/serve-static": "^2.2.0",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.14",
    "rimraf": "^3.0.2"
  },
  "dependencies": {
    "@themost/client": "^2",
    "@themost/common": "^2",
    "@themost/data": "^2",
    "@themost/express": "^5",
    "@themost/node": "^2",
    "@themost/query": "^2",
    "@themost/sqlite": "lts-22",
    "@themost/web": "^2",
    "@themost/xml": "^2",
    "express": "^5.3.0",
    "minimist": "^1.2.8",
    "twig": "^3.0.0"
  }
}
